{
  "name": "@files-ui/react",
  "version": "2.1.0",
  "description": "UI components for file uploads with React js",
  "main": "./build/index.js",
  "module": "./build/index.es.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.es.js",
      "require": "./build/index.js"
    },
    "./client/dropzone": {
      "import": "./build/client/dropzone.es.js",
      "require": "./build/client/dropzone.js"
    },
    "./client/file-input-button": {
      "import": "./build/client/file-input-button.es.js",
      "require": "./build/client/file-input-button.js"
    },
    "./client/file-card": {
      "import": "./build/client/file-card.es.js",
      "require": "./build/client/file-card.js"
    },
    "./client/file-mosaic": {
      "import": "./build/client/file-mosaic.es.js",
      "require": "./build/client/file-mosaic.js"
    },
    "./client/avatar": {
      "import": "./build/client/avatar.es.js",
      "require": "./build/client/avatar.js"
    },
    "./client/full-screen": {
      "import": "./build/client/full-screen.es.js",
      "require": "./build/client/full-screen.js"
    }
  },
  "scripts": {
    "build": "rollup -c && node ./scripts/generate-client-entrypoints.cjs",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/files-ui/files-ui-react.git"
  },
  "keywords": [
    "file",
    "upload",
    "dropzone",
    "file upload",
    "uploader",
    "file uploader",
    "typescript",
    "drag",
    "drop",
    "drag-drop",
    "preview",
    "ui",
    "file",
    "uploader",
    "uploader",
    "files",
    "material",
    "mui",
    "framework",
    "front-end",
    "kamui",
    "react",
    "react-component"
  ],
  "author": "JinSSJ3",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/files-ui/files-ui-react/issues"
  },
  "homepage": "https://www.files-ui.com",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.8",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^11.1.6",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^14.1.0",
    "@types/jest": "^30.0.0",
    "autoprefixer": "^10.4.14",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^29.7.0",
    "rollup": "^4.20.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-preserve-directives": "^0.4.0",
    "rollup-plugin-sass": "^1.12.19",
    "rollup-plugin-typescript2": "^0.34.1",
    "sass": "^1.101.3",
    "ts-jest": "^29.0.5",
    "tslib": "^2.8.1",
    "typescript": "^5.0.2"
  },
  "peerDependencies": {
    "@types/react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react": "^17.0.2 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.2 || ^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@dynamicss/dynamicss": ">=2.2.8",
    "@files-ui/core": ">=2.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
