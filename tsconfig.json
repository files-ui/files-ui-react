{
  "compilerOptions": {
    "allowJs": true,
    "declaration": true,
    "declarationDir": "build",
    "outDir": "./build",
    "rootDir": "./src",
    "module": "esnext",
    "target": "es2015",
    "lib": ["es2015", "dom", "es2016", "es2017"],
    "sourceMap": true,
    "jsx": "react",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "build"],
  "baseUrl": "./"
}